generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  SUBSCRIPTION
  RECEIVED
  SENT
}

enum CardBrand {
  MASTERCARD
  VISA
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  /// Salted scrypt hash, never the password itself.
  passwordHash String
  account      Account?
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  /// SHA-256 of the cookie token, so a database leak exposes no usable session.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Account {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 4217 code.
  currency     String     @default("USD")
  /// Integer cents, so amounts never go through floating point.
  balanceCents Int
  cardBrand    CardBrand
  cardLast4    String
  cardHolder   String
  /// Formatted as MM/YY.
  cardExpiry   String
  movements    Movement[]
}

model Movement {
  id           String       @id @default(uuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         MovementType
  /// Person or service on the other side of the movement.
  counterparty String
  /// Integer cents, always positive. The direction comes from `type`.
  amountCents  Int
  /// Operation number shown on the detail screen.
  reference    String       @unique
  occurredAt   DateTime

  @@index([accountId, occurredAt(sort: Desc)])
}
